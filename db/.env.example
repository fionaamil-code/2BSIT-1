# Copy this file to ".env" (same folder) and fill it in. NEVER commit ".env".
#
# Supabase dashboard -> your project -> "Connect" -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
# If the password has special characters (@ : / # ? %), URL-encode them (@ -> %40).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres
